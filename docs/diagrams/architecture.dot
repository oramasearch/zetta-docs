  "ARC-6" [label="ARC-6\nCluster-parallel\nnative compute engine", fillcolor="#fff3e0"];
  "ARC-7" [label="ARC-7\nNode bootstrap\nprovider (ZettaDB-\nnative)", fillcolor="#fff3e0"];
  "ARC-8" [label="ARC-8\nBurst / batch compute\nprovisioner", fillcolor="#fff3e0"];
  "RSK-1" [label="RSK-1\nZettaDB maturity is\nthe gating risk", fillcolor="#fbe9e7"];
  "RSK-2" [label="RSK-2\nGenerated-graph\ncorrectness", fillcolor="#fbe9e7"];
