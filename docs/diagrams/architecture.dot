digraph architecture {
  rankdir=LR; bgcolor="transparent";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10];
  edge [fontname="Helvetica" fontsize=8 color="#777777"];
  "ADR-1" [label="ADR-1\nZettaDB is the spine\n(no separate Postgres\ncontrol plane)", fillcolor="#fff3e0"];
  "ADR-2" [label="ADR-2\nExecution-graph IR as\nthe compile target", fillcolor="#fff3e0"];
  "ADR-3" [label="ADR-3\nCorrectness gate\nbefore deploy", fillcolor="#fff3e0"];
