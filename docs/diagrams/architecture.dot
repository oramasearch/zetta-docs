  "ADR-11" [label="ADR-11\nRunner & Extension\nabstraction via common\ninterfaces", fillcolor="#fff3e0"];
  "ADR-12" [label="ADR-12\nCapability-scoped,\ndeny-by-default\nextension sandbox", fillcolor="#fff3e0"];
  "ADR-13" [label="ADR-13\nOrly — first-party DSL\n(Lua-alternative\nrunner)", fillcolor="#fff3e0"];
