  "ADR-16" [label="ADR-16\nInterface-first /\npluggable-\nimplementations", fillcolor="#fff3e0"];
  "ADR-17" [label="ADR-17\nNative (C++/CUDA)\ncluster-parallel\ncompute for all heavy", fillcolor="#fff3e0"];
  "ADR-18" [label="ADR-18\nCluster trust model:\nmTLS + per-node\nidentity + capability-", fillcolor="#fff3e0"];
  "ADR-19" [label="ADR-19\nNode bootstrapping is\nZettaDB-native; k0s is\ninspiration only", fillcolor="#fff3e0"];
  "ADR-20" [label="ADR-20\nTwo provisioning\nmodes: persistent\ncluster nodes +", fillcolor="#fff3e0"];
